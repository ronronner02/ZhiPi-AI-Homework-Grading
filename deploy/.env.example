# 智批π Demo 公网部署配置
# 复制为 .env 后按需填写。**除 ZHIPI_DOUBLE_CHECK 外，留空即为关闭**；
# 全部留空时行为与本机离线演示一致（ZHIPI_DOUBLE_CHECK 的例外见第三节）。
#
#   cp .env.example .env
#
# 注意：.env 会包含密钥，已在 .gitignore 中排除，不要提交。

# ============================================================
# 一、访问控制（公网必填）
# ============================================================

# 访问口令。留空 = 任何人都能打开。
# 挂公网时**务必设置**：链接可以随便转发，但没口令打不开。
# 分享方式：https://你的域名/?code=口令   —— 服务端校验后会 303 跳转，
# 把明文口令从地址栏抹掉并写入 HttpOnly Cookie。
ZHIPI_ACCESS_CODE=

# 是否信任反向代理的 X-Forwarded-For 来判定客户端 IP。
# 关键取舍：前面**确实**有 Nginx/SLB 时设为 1，否则限流会把所有人算成同一个 IP；
# 但若直接暴露给公网还设 1，任何人都能伪造这个头来绕过限流。
ZHIPI_TRUST_PROXY=

# ============================================================
# 二、限流与配额（公网强烈建议）
# ============================================================

# 单 IP 滑动窗口限流，格式「次数/秒数」。默认 30/600（10 分钟 30 次）。
ZHIPI_RATE_LIMIT=30/600

# 请求体与单图上限（MB）。前端会先把 >1MB 的照片压到 1600px 长边再传，
# 这两条是防滥用的兜底，不是给正常用户设的门槛。
ZHIPI_MAX_BODY_MB=12
ZHIPI_MAX_IMAGE_MB=8

# 每日调用上限，0 = 不限。配了真实 VLM Key 后**务必设置**，否则一晚上能把余额刷干。
# 超限后自动回落到离线样例匹配，页面明确告知，不把报错甩给体验者。
ZHIPI_VLM_DAILY_LIMIT=200
ZHIPI_GRADE_DAILY_LIMIT=400

# 会话上限与存活时长（秒）、单会话最多保留几张上传件。
ZHIPI_SESSION_MAX=300
ZHIPI_SESSION_TTL=7200
ZHIPI_UPLOAD_MAX=20

# ============================================================
# 三、真实模型（留空 = 离线演示模式，不消耗任何 API）
# ============================================================

# 批改用的文本大模型。不配则走内置规则引擎（mock）。
ZHIPI_LLM_API_KEY=
ZHIPI_LLM_BASE_URL=
ZHIPI_LLM_MODEL=

# 单次批改调用的超时秒数（默认 30，范围 5-600）。
#
# 30 秒是按「课堂演示不能久等」定的。但实测中转网关 / 免费通道的**同一模型、
# 同一 prompt** 耗时会剧烈波动：21.5s → 60.6s → 超过 180s 都出现过。
# 超时会被 grade() 静默降级成 mock 规则引擎——界面照常出分、置信度、红黄绿
# 分流，只有 /api/demo/config 的 mode 字段会变。所以：
#
#   - 演示：保持 30 左右，配一个**快**的模型（实测 5-10 秒级的才够用）；
#     慢模型配大超时只是把「失败」换成「转圈两分钟」，体验一样差。
#   - 批量评测：显式调到 120 以上，否则会把「网关慢」记成「批改失败」，
#     污染评测数据（详见 docs/08-实测踩坑记录.md §二）。
ZHIPI_LLM_TIMEOUT=30

# 手写识别用的多模态模型。不配则只能识别内置样例照片
# （靠感知哈希匹配），体验者上传任意照片会收到明确提示而不是报错。
ZHIPI_VLM_API_KEY=
ZHIPI_VLM_MODEL=

# 多模态接口地址与模型。默认阿里云百炼 compatible-mode + qwen-vl-max。
# 换其他厂商（智谱 GLM-4V、Kimi、OpenAI 兼容网关等）时才需要改这两项。
ZHIPI_VLM_BASE_URL=
# ZHIPI_VLM_MODEL 见上方

# ---- 二次批改自检（注意：这一项是唯一的「留空即开启」例外）----
# 同一个模型再批一遍、比对两次结果算一致性因子，会让**每次批改的调用量翻倍**。
# 代码里默认开启，只有显式写 0 才关闭：
#     ZHIPI_DOUBLE_CHECK=0    → 关闭，省一半调用
#     留空 / 不写 / 写 1      → 开启（默认）
# 预算紧就写 0。
ZHIPI_DOUBLE_CHECK=0

# ---- 双模型交叉验证（可选，P2 能力）----
# 用**另一家**模型对黄/红结果独立再批一次，分差超过满分 15% 就强制转人工，
# 用来兜住单一模型的系统性误判。三项必须配齐才生效，缺一项即视为未启用。
# 只在黄/红触发（绿区不调用），所以增量成本远小于翻倍。
#
# 选第二模型时**必须实测**，别只看名字。这条路径的失败是静默的
# （拿不到结论就跳过，界面毫无提示），所以配错了不会报错，只是永远不生效。
# 两个坑都真实踩过：
#   · 太慢：单次 60–90 秒，而 ZHIPI_CROSS_TIMEOUT 默认 12 秒 → 每次必然超时，
#     黄/红件白等满 12 秒拿到 None。带 flash / fast 字样的也可能是慢的。
#   · 判分不稳：给满分卷扣分、或同一份卷多次给分漂动超过转红阈值（满分 15%），
#     会把好卷误判成「两模型分歧」强制转人工，人工队列被噪声灌满。
# 实测脚本：py -3 tools/bench_second_model.py（量耗时 + 错卷/对卷判分稳定性）
ZHIPI_LLM_API_KEY_2=
ZHIPI_LLM_BASE_URL_2=
ZHIPI_LLM_MODEL_2=

# 交叉验证的独立超时（秒）。留空 = 12 秒，对多数第二模型来说**都不够**，
# 必须按实测最慢值调大，否则上面配的第二模型等于没配。
# 本项目实测（中转网关，同一道题重复批）：
#   grok-4.5      77–91s      glm-5.2     45–65s
#   glm-4.5-flash 49–72s      minimax-m3  25–90s（中位 62s）
# 现用 minimax-m3 + 120s。代价：黄/红件单份等待 ≈ 3.4s 主批改
# + 3.4s 二次复批 + ~62s 交叉验证 ≈ 70 秒；绿区不受影响（按设计跳过）。
# 现场演示不想等，就把 ZHIPI_LLM_MODEL_2 留空明确停用，而不是留个必超时的配置。
ZHIPI_CROSS_TIMEOUT=

# ============================================================
# 四、飞书集成（留空 = demo 模式，界面照常演示但不真发）
# ============================================================

ZHIPI_FEISHU_WEBHOOK=
# 自定义机器人若开启了「签名校验」，把密钥填这里；未开启可留空。
ZHIPI_FEISHU_WEBHOOK_SECRET=
ZHIPI_FEISHU_APP_ID=
ZHIPI_FEISHU_APP_SECRET=
ZHIPI_FEISHU_BASE_APP_TOKEN=
ZHIPI_FEISHU_TABLE_ID=
ZHIPI_REVIEW_CONSOLE_URL=

# ============================================================
# 五、宿主侧端口绑定（只影响 docker-compose 的端口映射）
# ============================================================

# 对外端口。前面有 Nginx 时建议把 ZHIPI_BIND 改成 127.0.0.1，
# 让容器端口不直接对公网开放。
ZHIPI_PUBLIC_PORT=8010
ZHIPI_BIND=0.0.0.0
