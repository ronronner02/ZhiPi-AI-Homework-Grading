# 运行环境：development / production / test
ZHIPI_ENV=development
ZHIPI_HOST=127.0.0.1
ZHIPI_PORT=8010

# 生产环境必须设置。访问口令用于单工作区教师登录；密钥用于签名登录 Cookie。
ZHIPI_ACCESS_CODE=
ZHIPI_SECRET_KEY=
ZHIPI_SECURE_COOKIE=0
ZHIPI_WORKSPACE_ID=default

# 持久化目录。默认是项目内 runtime/，容器里建议挂载 /data。
ZHIPI_DATA_DIR=

# 上传边界
ZHIPI_MAX_BODY_MB=16
ZHIPI_MAX_IMAGE_MB=8
ZHIPI_MAX_IMAGE_PIXELS=40000000

# OpenAI 兼容多模态接口。三项齐全时可从已上传作业图生成待教师核对的转写。
ZHIPI_VLM_API_KEY=
ZHIPI_VLM_BASE_URL=
ZHIPI_VLM_MODEL=
ZHIPI_VLM_TIMEOUT=90
ZHIPI_VLM_DAILY_LIMIT=0

# OpenAI 兼容接口。三项齐全时启用真实文本批改；留空时内置样例仍可完整体验，
# 新上传作业进入“人工终审”而不是伪造 AI 分数。
ZHIPI_LLM_API_KEY=
ZHIPI_LLM_BASE_URL=
ZHIPI_LLM_MODEL=
ZHIPI_LLM_TIMEOUT=90
ZHIPI_LLM_DAILY_LIMIT=0
